            "title": [
                "北今西のオコナイ",
                "野迫川村北今西"
            ],
            "description": "奈良県無形文化遺産",
            "note": [
                "January 2nd every year",
                "毎年 一月二日 午後九時"
            ],
            "info": {
                "note": [
                    "オコナイは、新年から春の初めにかけて、村の寺堂や神社で行われる、五穀豊穣を祈る行事",
                    "（仏教の修正会（旧年の罪や過ちを仏前で懺悔し、新年の平安・豊穣を祈る儀式）が、民間の信仰・習俗を取り込んで独自に発展し、西日本各地に広く分布した）",
                    "紙の造花や丸太を杉葉で包んだ台に蜜柑や芋を挿した盛物を供え、数十本のシラクチカズラで編んだ大きな輪に樒の葉等を飾り付けられる"
                ],
                "links": null
            }
        },
        {
            "date": {
                "month": 1,
                "date": [
                    1,
                    2,
                    3
                ]
            },
            "title": [
                "弓手原のオコナイ",
                "野迫川村弓手原"
            ],
            "description": "奈良県無形文化遺産（平成27年度を最後に中断）",
            "note": [
                "DEcenber 30th - January 3rd every year",
                "毎年 十二月三十日から一月三日 午後七時"
            ],
            "info": {
                "note": [
                    "オコナイは、新年から春の初めにかけて、村の寺堂や神社で行われる、五穀豊穣を祈る行事",
                    "（仏教の修正会（旧年の罪や過ちを仏前で懺悔し、新年の平安・豊穣を祈る儀式）が、民間の信仰・習俗を取り込んで独自に発展し、西日本各地に広く分布した）",
                    "大きな掛餅や造花による荘厳をはじめ、貝吹きや鬼踊り（裸踊り）など高野山麓のオコナイの姿を最もよく伝える正月行事だった"
                ],
                "links": null
            }
        }
